{
  "name": "keywordscope",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node --env-file=.env.local scripts/test-workspace-isolation.mjs",
    "test:keyword-ops": "node --env-file=.env.local scripts/test-keyword-operations.mjs",
    "test:gsc-security": "node --env-file=.env.local scripts/test-gsc-security.mjs",
    "test:e2e": "playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:verify": "node --env-file=.env.local scripts/verify-local-supabase.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "^27.2.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@10.34.9"
}
